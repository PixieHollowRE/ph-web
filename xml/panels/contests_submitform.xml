		<erroralertok><![CDATA[OK]]></erroralertok>
		
		<toulink></toulink>
	</copy>
	<config>
		
		<contenttype>gardencontest</contenttype>
		<sheet>css/site.css</sheet>
		<thankyou>contests_thankyouform.xml</thankyou>
		<toulink><![CDATA[http://disney.go.com/corporate/privacy/terms.html?ppLink=pp_wdig]]></toulink>
		<contestRuleslink><![CDATA[http://disney.go.com/fairies/pixiehollow/rules.html]]></contestRuleslink>
		<contenttypes>
			<contenttype id="fairytale">
				<label><![CDATA[Fairy Tale]]></label>
				<arttext><![CDATA[Your Writing:]]></arttext>
				<descriptiontext required="true"><![CDATA[Your Fairy Tale:]]></descriptiontext>
				<uploadURL><![CDATA[http://dnhdolapp05.go.com:7178/fairies/uploadFairyTale]]></uploadURL>
				<requiredfields>
					<requiredfield>fairyname</requiredfield>
					<requiredfield>description</requiredfield>
				</requiredfields>
			</contenttype>
			<contenttype id="seasonalshout">
				<label><![CDATA[Seasonal Shoutout]]></label>
				<arttext><![CDATA[Your Writing:]]></arttext>
				<descriptiontext required="true"><![CDATA[Your Seasonal Shoutout:]]></descriptiontext>
				<uploadURL><![CDATA[http://dnhdolapp05.go.com:7178/fairies/uploadSeasonalShoutOut]]></uploadURL>
				<requiredfields>
					<requiredfield>fairyname</requiredfield>
					<requiredfield>description</requiredfield>
				</requiredfields>
			</contenttype>
			<contenttype id="poem">
				<label><![CDATA[Poem]]></label>
				<arttext required="true"><![CDATA[Your Writing:]]></arttext>
				<descriptiontext><![CDATA[Your Poem:]]></descriptiontext>
				<uploadURL><![CDATA[http://dnhdolapp05.go.com:7178/fairies/uploadPoem]]></uploadURL>
				<requiredfields>
					<requiredfield>fairyname</requiredfield>
					<requiredfield>description</requiredfield>
				</requiredfields>
			</contenttype>
			<contenttype id="question">
				<label><![CDATA[Question for Tabby]]></label>
				<arttext><![CDATA[Your Writing:]]></arttext>
				<descriptiontext required="true"><![CDATA[Your Question for Tabby:]]></descriptiontext>
				<uploadURL><![CDATA[http://dnhdolapp05.go.com:7178/fairies/uploadQuestion]]></uploadURL>
				<requiredfields>
					<requiredfield>fairyname</requiredfield>
					<requiredfield>description</requiredfield>
				</requiredfields>
			</contenttype>
			<contenttype id="gardencontest">
				<label><![CDATA[Art]]></label>
				<arttext required="true"><![CDATA[Your Art:]]></arttext>
				<descriptiontext><![CDATA[Your Description:]]></descriptiontext>
				<uploadURL><![CDATA[http://premium.disney.go.com/fairies/uploadGardenContest]]></uploadURL>
				<requiredfields>
					<requiredfield>fairyname</requiredfield>
					<requiredfield>artname</requiredfield>
					<requiredfield>file</requiredfield>
				</requiredfields>
			</contenttype>
		</contenttypes>
	</config>
</panel>

