		<text14 target="submitcontent.passField">Password</text14>
		
		<text15 target="submitcontent.importfile.yourartHolder.browseBtn.caption">Browse</text15>
		<text16 target="submitcontent.submitBtn.caption">Submit</text16>
		<text17 target="submitcontent.resetBtn.caption">Reset</text17>
		
		
		
		<text target="submitcontent.cancelBtn.caption">Close</text>
		<text target="submitcontent.loginBtn.caption">Login</text>
		<text target="stillholding.lowerCopy1">Sorry, still not ready yet...</text>
