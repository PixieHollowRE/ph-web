		<text4 target="submitcontent.lowerCopy2" style="html"><![CDATA[Name of Your Artwork:]]></text4>
		<text5 target="submitcontent.importfile.lowerCopy3" style="html"><![CDATA[Your File:]]></text5>
		<text6 target="submitcontent.lowerCopy7" style="html"><![CDATA[Your Fairy's Name:]]></text6>
		<text7 target="submitcontent.lowerCopy5" style="html"><![CDATA[Terms of Use]]></text7>
		<lowerCopy6 target="submitcontent.lowerCopy6" style="html"><![CDATA[<body>If you are under 13 years old, please ask your parents to review the Disney Pixie Hollow Terms of Use with you.</body>]]></lowerCopy6>
		<txt_touaccept target="submitcontent.touTAHolder.txt_touaccept" style="html"><![CDATA[<body>I agree to the Disney Fairies Pixie Hollow Terms of Use</body>]]></txt_touaccept>
