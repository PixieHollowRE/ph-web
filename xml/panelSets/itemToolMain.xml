		<panel id="color" x="0" y="0" refocusable="false" hidden="true" transition="none">{panelData}/tools/infoCardColor.xml</panel>
		<panel id="colorMap" x="0" y="0" refocusable="false" hidden="true" transition="none">{panelData}/tools/infoCardColorMap.xml</panel>
