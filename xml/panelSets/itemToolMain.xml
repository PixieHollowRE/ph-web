	<config>
		<additionalFiles>
			<file name="createFairy" native="false" side="client">xml/caf/cafData.xml</file>
			<file name="initialItems" native="false" side="server">InitialItemsAssets.xml</file>
			<file name="serverBadgeUnlock" native="false" side="server">badges.xml</file>
			<file name="serverBadgeEvents" native="false" side="server">events.xml</file>
		</additionalFiles>
		<panelsLater>
			<editAvatarPanel id="editAvatar" x="200" y="100" alwaysOnTop="true" hidden="true">{panelData}/tools/cardEditAvatar.xml</editAvatarPanel>
			<saveAvatarPanel id="saveAvatar" x="300" y="200" alwaysOnTop="true" hidden="true">{panelData}/tools/cardSaveFileOptions.xml</saveAvatarPanel>
		</panelsLater>
	</config>
	<copy>
	</copy>
