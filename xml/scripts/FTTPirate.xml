<script useSceneTitles="0">
  <scene id="1">
    <line id="0" role="WINDY" emote="0" direction="BOTH FAIRIES ARE HIDING">Here come the pirates!</line>
    <line id="1" role="FOXMOON" direction="HOOK &amp; SMEE ENTER">And they have our special map!</line>
    <line id="2" role="SMEE">You're sure this map will lead us to the Fairies, Cap'n?</line>
    <line id="3" role="HOOK">As sure as my hook is sharp, Mister Smee.</line>
    <line id="4" role="HOOK">And this time, we'll catch one!</line>
    <line id="5" role="SMEE">Cap'n, the map says to pull this vine.</line>
    <line id="6" role="HOOK">Well, don't just stand there! Pull it!</line>
    <line id="7" role="SMEE" emote="1" direction="USE VINE PROP">Right away, Cap'n -- BLUURB!</line>
    <line id="8" role="HOOK" emote="5">Fool, we're soaked with water!</line>
    <line id="9" role="WINDY" direction="STILL HIDING">Hee hee!</line>
    <line id="10" role="FOXMOON" direction="STILL HIDING">Shhh!</line>
    <line id="11" role="HOOK">Press on, Mister Smee!</line>
    <line id="12" role="SMEE">Here, Cap'n! The map says to push this thorny plant!</line>
    <line id="13" role="HOOK">... YOU do it.</line>
    <line id="14" role="SMEE">Aye-aye, Cap'n!</line>
    <line id="15" role="SMEE" direction="USE PLANT PROP">YEEEOOOWWWCH!</line>
    <line id="16" role="WINDY">Ha ha!</line>
    <line id="17" role="FOXMOON">Hee hee!</line>
    <line id="18" role="HOOK" emote="8">Scuttle me bones, something's fishy here...</line>
    <line id="19" role="SMEE">What do you mean, Cap'n?</line>
    <line id="20" role="HOOK">Never mind. The map says there should be a rock with an X on it.</line>
    <line id="21" role="SMEE">You know what they say -- X marks the spot!</line>
    <line id="22" role="FOXMOON" direction="STILL HIDING">Ooooooooo!</line>
    <line id="23" role="HOOK">Shhh! W-what was that?</line>
    <line id="24" role="SMEE">Sounded like -- ghosts!</line>
    <line id="25" role="FOXMOON">This place be cursed! Ye are doomed!</line>
    <line id="26" role="HOOK" direction="PIRATES STAND ON TRAP DOOR">Press the X on this rock, Smee! Hurry!</line>
    <line id="27" role="SMEE" direction="USE ROCK PROP">Aye-aye, Cap'n!</line>
    <line id="28" role="WINDY" direction="POPS OUT FROM BEHIND ROCK">BOO!</line>
    <line id="29" role="SMEE" emote="1">EEEK!</line>
    <line id="30" role="HOOK" emote="1" direction="PIRATES FALL DOWN TRAP DOOR">AAAH!</line>
    <line id="31" role="WINDY">The pirates will never find Pixie Hollow!</line>
    <line id="32" role="FOXMOON" emote="4">That was great! Let's draw another map!</line>
  </scene>
</script>